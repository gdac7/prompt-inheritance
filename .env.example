# Token do Hugging Face com acesso a meta-llama/Llama-3.1-8B-Instruct, google/gemma-1.1-7b-it (juiz)
# e ao dataset walledai/HarmBench (aceite os termos de cada um no site)
HF_TOKEN=
# Cache de modelos no host (crie a pasta antes do primeiro run; ~60 GB)
HF_CACHE=~/.cache/huggingface
# Usuário do container. Docker comum: id -u / id -g. Docker rootless: 0 e 0 (o root do
# container é o seu usuário no host; outro UID não consegue gravar no repositório)
HOST_UID=1000
HOST_GID=1000
# Juiz: 127.0.0.1 com o serviço judge do compose; outro IP para um juiz em outra máquina (porta 8001)
SCORER_ADDRESS=127.0.0.1
# GPUs (índices do nvidia-smi): duas para geração/alvo, como no artigo, e uma para o juiz
GPU_0=0
GPU_1=1
JUDGE_GPU=2
